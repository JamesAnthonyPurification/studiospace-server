# Port for local development
PORT=5000

# MongoDB connection string (Atlas or local) and database name.
# Use the SAME database as the Next.js client so BetterAuth and the API share data.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Front-end origin(s), comma separated. The first one is used to fetch BetterAuth's JWKS.
CLIENT_URL=http://localhost:3000

# Secret used to sign the HTTPOnly session cookie issued by this API
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: override where BetterAuth's public keys live (defaults to CLIENT_URL/api/auth/jwks)
# BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Optional: email of the examiner/demo account used by the seed script
DEMO_USER_EMAIL=examiner@example.com
DEMO_USER_NAME=Examiner Demo
